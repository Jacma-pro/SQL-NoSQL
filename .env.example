# Copier ce fichier en .env (non versionné) puis remplacer les valeurs.
# Ces valeurs sont FACTICES.

# Mot de passe du super-utilisateur postgres (sert seulement à initialiser la base)
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe

# Mot de passe du rôle limité hotel_api, utilisé par l'API
HOTEL_API_PASSWORD=remplacer_par_un_autre_mot_de_passe
